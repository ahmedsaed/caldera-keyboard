#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// ---------------------------------------------------------------------------------
// |  ESC |  1  |  2  |  3  |  4  |  5  |     |  6  |  7  |  8  |  9  |  0  | BKSP |
// |  TAB |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U  |  I  |  O  |  P  |  \   |
// | CAPS |  A  |  S  |  D  |  F  |  G  |     |  H  |  J  |  K  |  L  |  ;  |  ENT |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M  |  ,  |  .  |  /  | RSHFT|
// | CTRL | GUI | ALT | SPC | SPC | HIGH|     |HIGH | SPC | SPC | ALT | LOW | CTRL |
                        bindings = <
   &kp ESC    &kp N1    &kp N2    &kp N3     &kp N4     &kp N5               &kp N6     &kp N7  &kp N8     &kp N9    &kp N0    &kp BSPC
   &kp TAB    &kp Q     &kp W     &kp E      &kp R      &kp T                &kp Y      &kp U   &kp I      &kp O     &kp P     &kp BSLH
   &kp CAPS   &kp A     &kp S     &kp D      &kp F      &kp G                &kp H      &kp J   &kp K      &kp L     &kp SEMI  &kp RET
   &kp LSHFT  &kp Z     &kp X     &kp C      &kp V      &kp B                &kp N      &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
   &kp LCTRL  &kp LGUI  &kp LALT  &kp SPACE  &kp SPACE  &mo 2                &mo 2      &kp SPACE &kp SPACE &kp LALT  &mo 1     &kp RCTRL
                        >;
                };
                lower_layer {
// ------------------------------------------------------------------------------------------------------------
// | TILDE |  BT1  |  BT2  |  BT3  |  BT4  |  BT5  |          |       |       |       |       |       | BTCLR |
// |       |       |       |       |       |       |          |       |       |       |       |       | UNLCK |
// |       |       |       |       |       |       |          |       |       |       |   -   |   =   |  DEL  |
// |       |       |       | LPAR  | RPAR  | HOME  |          |  END  | LBKT  | RBKT  |       |       | APOS  |
                        bindings = <
   &kp TILDE &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4           &trans    &trans    &trans      &trans     &trans     &bt BT_CLR
   &trans    &trans         &trans         &trans         &trans         &trans                 &trans    &trans    &trans      &trans     &trans     &studio_unlock
   &trans    &trans         &trans         &trans         &trans         &trans                 &trans    &trans    &trans      &kp MINUS  &kp EQUAL  &kp DEL
   &trans    &trans         &trans         &kp LPAR       &kp RPAR       &kp HOME               &kp END   &kp LBKT  &kp RBKT    &trans     &trans     &kp APOS
                        >;
                };
                high_layer {
// ------------------------------------------------------------------------------------------------------------
// | GRAVE |  F1   |  F2   |  F3   |  F4   |  F11  |          |  F12  |  F7   |  F8   |  F9   | F10   | BKSP  |
// |       |       |  UP   |       |       |       |          |       |       |       |       |       |       |
// |       | LEFT  | DOWN  | RIGHT |       |       |          |       |       |       |   -   |   =   |  DEL  |
// |       |       |       | LPAR  | RPAR  | HOME  |          |  END  | LBKT  | RBKT  |       |       | APOS  |
                        bindings = <
   &kp GRAVE &kp F1    &kp F2    &kp F3     &kp F4     &kp F11              &kp F12    &kp F7    &kp F8     &kp F9     &kp F10    &kp BSPC
   &trans    &trans    &kp UP    &trans     &trans     &trans               &trans     &trans    &trans     &trans     &trans     &trans
   &trans    &kp LEFT  &kp DOWN  &kp RIGHT  &trans     &trans               &trans     &trans    &trans     &kp MINUS  &kp EQUAL  &kp DEL
   &trans    &trans    &trans    &kp LPAR   &kp RPAR   &kp HOME             &kp END    &kp LBKT  &kp RBKT   &trans     &trans     &kp APOS
                        >;
                };
                extra1 {
                        status = "reserved";
                };
                extra2 {
                        status = "reserved";
                };
        };
};
